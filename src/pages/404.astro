---
import Layout from "../layouts/Layout.astro";
import { Compass, Phone, Home, ArrowRight, IndianRupee, FileText, ShieldCheck, MapPin } from "lucide-react";

const title = "404 - Page Not Found | Puraniks Abitante Fiore Bavdhan Pune";
const description = "The page you requested could not be found. Explore verified pricing, floor plans, and MahaRERA details for Puraniks Abitante Fiore in Bavdhan, Pune.";
const canonical = "https://puraniksabitante.in/404";
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="min-h-screen bg-[#FAF9F6] text-[#0F172A] flex flex-col justify-between">
    
    <!-- Top Header -->
    <header class="bg-white border-b border-slate-200 py-3.5 px-4 sm:px-8">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center shrink-0">
          <img 
            src="/images/logo.webp" 
            alt="Puraniks Abitante Fiore Bavdhan Pune" 
            width="160"
            height="44"
            class="h-9 sm:h-11 w-auto object-contain"
            onerror="this.src='/favicon.svg'"
          />
        </a>
        <div class="flex items-center gap-3">
          <a 
            href="https://wa.me/917744009295?text=Hi,%20I%20am%20interested%20in%20Puraniks%20Abitante%20Fiore%20Bavdhan." 
            target="_blank" 
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 transition"
          >
            💬 WhatsApp
          </a>
          <a href="tel:+917744009295" class="px-4 py-2 rounded-xl bg-[#0F172A] text-white text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 hover:bg-slate-800 transition">
            <Phone className="w-3.5 h-3.5 text-amber-400" />
            <span>Call +91 7744009295</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main 404 Hero -->
    <div class="max-w-4xl mx-auto px-4 sm:px-8 py-16 text-center space-y-8">
      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-[11px] font-bold uppercase tracking-wider text-[#92400E]">
          <Compass className="w-3.5 h-3.5" /> 404 ERROR: PAGE MOVED OR NOT FOUND
        </div>
        <h1 class="text-4xl sm:text-6xl font-black text-[#0F172A] tracking-tight">
          Looking for Puraniks Abitante Fiore?
        </h1>
        <p class="text-sm sm:text-base text-slate-600 max-w-xl mx-auto leading-relaxed">
          The link you clicked may have moved or been updated during our latest platform upgrade. Please choose from our primary verified portals below:
        </p>
      </div>

      <!-- Quick Portals Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 text-left">
        <a href="/" class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-[#92400E] shadow-2xs hover:shadow-md transition space-y-2 group">
          <div class="w-8 h-8 rounded-lg bg-amber-50 text-[#92400E] flex items-center justify-center font-bold">
            <Home className="w-4 h-4" />
          </div>
          <div class="font-bold text-slate-900 group-hover:text-[#92400E] text-sm">Official Township Overview</div>
          <div class="text-xs text-slate-500">Explore 45-acre master plan, Italian concept, and virtual tour.</div>
        </a>

        <a href="/puraniks-abitante-price" class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-[#92400E] shadow-2xs hover:shadow-md transition space-y-2 group">
          <div class="w-8 h-8 rounded-lg bg-amber-50 text-[#92400E] flex items-center justify-center font-bold">
            <IndianRupee className="w-4 h-4" />
          </div>
          <div class="font-bold text-slate-900 group-hover:text-[#92400E] text-sm">Verified Price List 2026</div>
          <div class="text-xs text-slate-500">1, 2 & 3 BHK cost sheets from ₹59 Lakhs* with 0% stamp duty.</div>
        </a>

        <a href="/puraniks-abitante-floor-plan" class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-[#92400E] shadow-2xs hover:shadow-md transition space-y-2 group">
          <div class="w-8 h-8 rounded-lg bg-amber-50 text-[#92400E] flex items-center justify-center font-bold">
            <FileText className="w-4 h-4" />
          </div>
          <div class="font-bold text-slate-900 group-hover:text-[#92400E] text-sm">Floor Plans & Carpet Area</div>
          <div class="text-xs text-slate-500">2D AutoCAD layouts and 3D floor plan blueprints.</div>
        </a>

        <a href="/puraniks-abitante-rera" class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-[#92400E] shadow-2xs hover:shadow-md transition space-y-2 group">
          <div class="w-8 h-8 rounded-lg bg-amber-50 text-[#92400E] flex items-center justify-center font-bold">
            <ShieldCheck className="w-4 h-4" />
          </div>
          <div class="font-bold text-slate-900 group-hover:text-[#92400E] text-sm">MahaRERA 4-Phase Registry</div>
          <div class="text-xs text-slate-500">Certificates for P52100020202, 20238, 48353, and 49352.</div>
        </a>

        <a href="/puraniks-abitante-location" class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-[#92400E] shadow-2xs hover:shadow-md transition space-y-2 group">
          <div class="w-8 h-8 rounded-lg bg-amber-50 text-[#92400E] flex items-center justify-center font-bold">
            <MapPin className="w-4 h-4" />
          </div>
          <div class="font-bold text-slate-900 group-hover:text-[#92400E] text-sm">Location & Transit Radar</div>
          <div class="text-xs text-slate-500">5 mins to Chandani Chowk, 15 mins to Hinjewadi IT Park.</div>
        </a>

        <a href="/puraniks-abitante-contact-number" class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-[#92400E] shadow-2xs hover:shadow-md transition space-y-2 group">
          <div class="w-8 h-8 rounded-lg bg-amber-50 text-[#92400E] flex items-center justify-center font-bold">
            <Phone className="w-4 h-4" />
          </div>
          <div class="font-bold text-slate-900 group-hover:text-[#92400E] text-sm">Official Sales Desk</div>
          <div class="text-xs text-slate-500">Direct assistance at +91 7744009295.</div>
        </a>
      </div>

      <div class="pt-6">
        <a href="/" class="luxury-btn-gold px-8 py-3.5 rounded-xl text-xs font-bold uppercase tracking-wider inline-flex items-center gap-2">
          Return to Official Homepage <ArrowRight className="w-4 h-4" />
        </a>
      </div>
    </div>

    <!-- Footer -->
    <footer class="bg-[#0F172A] text-white py-10 px-4 text-center text-xs text-slate-400 border-t border-slate-800">
      <div class="max-w-7xl mx-auto space-y-4">
        <div class="flex items-center justify-center gap-3">
          <div class="h-10 w-auto bg-white p-1 rounded-xl flex items-center justify-center">
            <img 
              src="/images/logo.webp" 
              alt="Puraniks Abitante Fiore" 
              width="160"
              height="32"
              class="h-8 w-auto object-contain"
              onerror="this.src='/favicon.svg'"
            />
          </div>
          <span class="font-bold text-white text-sm">PURANIKS ABITANTE FIORE</span>
        </div>
        <p>Puraniks Abitante Fiore • Bavdhan Budruk, Pune - 411021</p>
        <p class="text-[11px] text-slate-500">MahaRERA: Phase 2A (P52100020202) • Phase 2B (P52100020238) • Phase 2C (P52100048353) • Phase 2C1 (P52100049352)</p>
      </div>
    </footer>

  </div>
</Layout>
