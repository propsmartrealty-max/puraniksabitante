---

<Layout 
  title="HTML Sitemap & Master Topic Directory | Puraniks Abitante Fiore Bavdhan"
  description="Complete crawlable HTML directory of all 110 official keyword silos, floor plans, pricing sheets, MahaRERA registrations and connectivity guides for Puraniks Abitante Fiore, Bavdhan, Pune."
  canonical="https://puraniksabitante.in/sitemap"
>
  <main class="min-h-screen bg-[#FAF9F6] text-[#0F172A] py-12 px-4 sm:px-8">
    <div class="max-w-7xl mx-auto space-y-10">
      
      {/* Header Banner */}
      <div class="bg-[#0B1329] text-white rounded-3xl p-8 sm:p-12 border border-slate-800 shadow-xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-mono font-bold uppercase tracking-wider">
          <ShieldCheck className="w-3.5 h-3.5" /> OFFICIAL CRAWLABLE REPOSITORY
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          Master HTML Sitemap & Content Directory
        </h1>
        <p class="text-slate-300 text-sm sm:text-base max-w-3xl leading-relaxed">
          Comprehensive directory indexing all <strong class="text-amber-400 font-bold">{totalUrls} official topic silos</strong> for Puraniks Abitante Fiore, Bavdhan Budruk, Pune. Built for instant discovery by Googlebot, Bingbot, and homebuyers.
        </p>
        <div class="flex flex-wrap items-center gap-4 text-xs text-slate-400 pt-2 font-mono">
          <span>✓ {totalUrls} Clean Static Endpoints</span>
          <span>•</span>
          <span>✓ 100% MahaRERA Verified</span>
          <span>•</span>
          <span>✓ Sub-15ms Edge Pre-rendered</span>
        </div>
      </div>

      {/* Grid of 15 Topical Silos */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sitemapGroups.map((group, idx) => (
          <section class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs hover:shadow-md transition-shadow space-y-4">
            <h2 class="text-base font-bold text-[#0F172A] pb-2 border-b border-slate-100 flex items-center justify-between">
              <span>{group.title}</span>
              <span class="text-xs font-mono text-[#92400E] font-extrabold">{group.urls.length} Nodes</span>
            </h2>
            <ul class="space-y-2">
              {group.urls.map((u) => (
                <li>
                  <a 
                    href={u.path} 
                    class="text-xs text-slate-600 hover:text-[#92400E] hover:font-bold transition-all flex items-center justify-between group py-1"
                  >
                    <span class="line-clamp-1">{u.name}</span>
                    <ArrowRight className="w-3 h-3 text-slate-300 group-hover:text-[#92400E] group-hover:translate-x-0.5 transition-all shrink-0 ml-2" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      {/* Direct XML & LLMs Feed Access */}
      <div class="bg-slate-100 rounded-2xl p-6 border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
        <div class="space-y-1">
          <div class="font-bold text-slate-900">Looking for Machine-Readable Feeds?</div>
          <div class="text-slate-500">Access XML Sitemaps and LLM Knowledge Bases for automated ingestion.</div>
        </div>
        <div class="flex items-center gap-3">
          <a href="/sitemap.xml" target="_blank" class="px-4 py-2 rounded-xl bg-white border border-slate-300 font-bold text-slate-800 hover:bg-slate-50 transition">
            XML Sitemap →
          </a>
          <a href="/llms.txt" target="_blank" class="px-4 py-2 rounded-xl bg-[#0B1329] text-amber-300 font-bold hover:bg-slate-900 transition">
            llms.txt →
          </a>
        </div>
      </div>

    </div>
  </main>
</Layout>
